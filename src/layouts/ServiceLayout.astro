---
// ServiceLayout.astro — обертка для страниц услуг
// Включает JSON-LD Service + FAQPage + Organization

import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  serviceName: string;
  serviceType: string;
  faq?: { question: string; answer: string }[];
  canonical?: string;
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  serviceName,
  serviceType,
  faq = [],
  canonical = Astro.url.href,
} = Astro.props;

const siteUrl = 'https://ai-bureau.pro';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: serviceName,
  description,
  url: canonical,
  provider: {
    '@type': 'Organization',
    name: 'AI Bureau',
    url: siteUrl,
  },
  areaServed: 'RU',
  serviceType,
  offerCategory: 'Business',
};

const faqJsonLd = faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;
---

<BaseLayout {title} {description} {ogImage} {canonical}>
  <!-- JSON-LD Service -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify(serviceJsonLd)}
  />

  <!-- JSON-LD FAQPage -->
  {faqJsonLd && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqJsonLd)}
    />
  )}

  <slot />
</BaseLayout>
