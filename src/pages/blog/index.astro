---
// src/pages/blog/index.astro — Блог AI Bureau (Content Collection)
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const title = 'Блог AI Bureau — статьи по LLM ops, RAG, AI-агентам';
const description =
  'Статьи о LLM ops, RAG, AI-агентах, голосовых ботах, private LLM, промпт-инжиниринге. Образовательный контент для бизнеса.';
const canonical = 'https://ai-bureau.pro/blog/';
const ogImage = '/og-default.png';

const posts = await getCollection('blog');
const sorted = posts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout {title} {description} {canonical} {ogImage}>
  <section class="hero">
    <div class="container">
      <div class="hero-content reveal">
        <span class="label">Блог</span>
        <h1>Статьи по AI-инжинирингу</h1>
        <p class="hero-desc">
          LLM ops, RAG, AI-агенты, голосовые боты, private LLM, промпт-инжиниринг —
          образовательный контент для бизнеса.
        </p>
      </div>
    </div>
  </section>

  <style>
    .hero {
      padding: 60px 0 48px;
      background: radial-gradient(ellipse at 20% 50%, var(--accent-dim) 0%, transparent 60%);
    }
    .hero-content {
      max-width: 620px;
    }
    .hero-desc {
      font-size: 1.05rem;
      color: var(--text);
      margin: 12px 0 0;
      line-height: 1.6;
    }
  </style>

  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {sorted.map((post) => {
          const { Content } = post;
          const { title, description, date, tags } = post.data;
          const slug = post.slug;
          return (
            <article class="blog-card reveal">
              <div class="blog-card-header">
                <div class="blog-date">
                  {new Date(date).toLocaleDateString('ru-RU', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                  })}
                </div>
                {tags.length > 0 && (
                  <div class="blog-tags">
                    {tags.slice(0, 3).map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                  </div>
                )}
              </div>
              <h3>
                <a href={`/blog/${slug}/`}>{title}</a>
              </h3>
              <p>{description}</p>
              <a href={`/blog/${slug}/`} class="blog-link">Читать →</a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <style>
    .blog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 24px;
    }
    .blog-card {
      padding: 24px;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }
    .blog-card-header {
      margin-bottom: 12px;
    }
    .blog-date {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-bottom: 8px;
    }
    .blog-tags {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .tag {
      font-size: 0.7rem;
      padding: 2px 6px;
      background: var(--accent-dim);
      color: var(--accent);
      border-radius: 4px;
      font-weight: 600;
    }
    .blog-card h3 {
      font-size: 1.05rem;
      margin-bottom: 8px;
    }
    .blog-card h3 a {
      color: var(--text);
    }
    .blog-card h3 a:hover {
      color: var(--accent);
    }
    .blog-card p {
      font-size: 0.9rem;
      line-height: 1.6;
      margin-bottom: 12px;
    }
    .blog-link {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--accent);
    }
  </style>
</BaseLayout>
