---
// src/pages/services/ai-agents.astro — AI-агенты с RAG
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const title = 'AI-агенты с RAG — разработка кастомных автономных систем | AI Bureau';
const description =
  'Разрабатываем кастомные AI-агенты для бизнеса: автоматизация процессов, мульти-агентные системы, AI-агенты с RAG. См. кейсы и процесс.';
const serviceName = 'Разработка AI-агентов';
const serviceType = 'AI Agent Development Services';
const canonical = 'https://ai-bureau.pro/services/ai-agents/';

const faq = [
  {
    question: 'Что такое AI-агенты и зачем они бизнесу?',
    answer:
      'AI-агенты — автономные системы, способные воспринимать окружение, планировать действия и выполнять сложные бизнес-задачи без постоянного вмешательства человека. В отличие от простых чат-ботов, агенты могут использовать инструменты, работать с документами, вызывать API, принимать решения в многошаговых сценариях. Для бизнеса это автоматизация процессов, снижение операционных затрат и масштабирование без увеличения штата.',
  },
  {
    question: 'Какие задачи решают AI-агенты?',
    answer:
      'AI-агенты применяются в автоматизации рабочих процессов, обработке документов и данных, взаимодействии с клиентами (чат и голос), анализе и принятии решений. Конкретные примеры: анализ контрактов, обработка заявок, генерация отчётов, обновление CRM, ответы на вопросы по базе знаний, выполнение сложных workflow-сценариев.',
  },
  {
    question: 'Какие технологии вы используете для разработки AI-агентов?',
    answer:
      'Мы работаем с LangChain, CrewAI, AutoGen, DSPy, LlamaIndex — в зависимости от задачи и требований. Архитектурно агенты включают модуль планирования, набор инструментов (инструментарий), память (долговременная и краткосрочная) и систему наблюдаемости (логирование, мониторинг качества). RAG-интеграция позволяет агентам работать с вашими документами и базами знаний.',
  },
  {
    question: 'Сколько времени занимает разработка AI-агента?',
    answer:
      'Прототип (MVP) мы можем подготовить за 2–4 недели для проверки гипотезы. Полноценная система с интеграциями, тестированием и внедрением в production создаётся в зависимости от сложности — обычно от 4 до 12 недель. Точные сроки определяются после диагностики и технического обследования.',
  },
];
---

<ServiceLayout
  {title}
  {description}
  {serviceName}
  {serviceType}
  {faq}
  {canonical}
>
  <!-- HERO -->
  <section class="service-hero">
    <div class="container">
      <div class="service-hero-content reveal">
        <span class="label">Услуга · AI-агенты</span>
        <h1>Кастомные AI-агенты для бизнеса: автоматизация, RAG, мульти-агентные системы</h1>
        <p class="service-hero-desc">
          AI-агенты — автономные системы, способные выполнять сложные бизнес-задачи.
          Мы проектируем агентов с RAG, инструментами, памятью и многошаговым
          планированием. LangChain, CrewAI, DSPy — выбираем стек под вашу задачу.
        </p>
        <div class="service-cta">
          <a href="/contact" class="btn">Заказать консультацию</a>
          <a href="/services/audit" class="btn btn-ghost">AI-аудит</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .service-hero {
      padding: 60px 0 48px;
      background: radial-gradient(ellipse at 80% 30%, var(--accent-dim) 0%, transparent 60%);
    }
    .service-hero-content {
      max-width: 720px;
    }
    .service-hero-desc {
      font-size: 1.05rem;
      color: var(--text);
      margin: 16px 0 28px;
      line-height: 1.7;
      max-width: 620px;
    }
    .service-cta {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }
  </style>

  <!-- ВВЕДЕНИЕ -->
  <section class="section">
    <div class="container">
      <div class="content-block reveal">
        <span class="label">О услуге</span>
        <h2>AI-агенты — автономные системы для сложных бизнес-задач</h2>
        <p>
          AI-агенты — это следующий шаг после простых чат-ботов и автоматизации.
          Где классические интеграции следуют заданным правилам, агенты
          принимают решения: анализируют контекст, выбирают инструменты,
          планируют многошаговые действия и корректируют стратегию на лету.
          Они работают с документами, базами данных, внешними API и
          корпоративными системами — и делают это автономно.
        </p>
        <p>
          AI Bureau проектирует агентов под конкретные бизнес-задачи: от
          автоматизации обработки заявок до сложных исследовательских
          workflow. Мы не используем шаблонные решения «из коробки» —
          каждый агент проектируется с учётом вашей инфраструктуры,
          данных и ограничений.
        </p>
      </div>
    </div>
  </section>

  <!-- ЗАДАЧИ -->
  <section class="section">
    <div class="container">
      <div class="content-block reveal">
        <h2>Для каких задач нужны AI-агенты</h2>
        <div class="tasks-list">
          <div class="task-item">
            <div class="task-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="3" width="7" height="7" rx="1" />
                <rect x="3" y="14" width="7" height="7" rx="1" />
                <path d="M14 14h7v7" />
              </svg>
            </div>
            <h3>Автоматизация рабочих процессов</h3>
            <p>
              Агенты выполняют многошаговые рутинные процессы: обработка
              входящих документов, создание и обновление записей в CRM,
              генерация отчётов, отправка уведомлений. Результат —
              снижение времени на repeatable-задачи на 60–90%.
            </p>
          </div>
          <div class="task-item">
            <div class="task-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <path d="M14 2v6h6" />
                <line x1="16" y1="10" x2="8" y2="10" />
                <line x1="16" y1="14" x2="8" y2="14" />
              </svg>
            </div>
            <h3>Обработка документов и данных</h3>
            <p>
              Извлечение данных из договоров, счётов, актов, форм. Классификация,
              сравнение, поиск аномалий. Агент читает документ, понимает структуру
              и извлекает нужную информацию — быстрее и точнее, чем ручная работа.
            </p>
          </div>
          <div class="task-item">
            <div class="task-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
              </svg>
            </div>
            <h3>Взаимодействие с клиентами</h3>
            <p>
              Чат и голосовые агенты, способные решать сложные задачи: консультировать
              по продукту, принимать заказы, обрабатывать жалобы, работать с
              возвратами. В отличие от FAQ-ботов, агент понимает контекст диалога
              и может выполнить действие в вашей системе.
            </p>
          </div>
          <div class="task-item">
            <div class="task-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
              </svg>
            </div>
            <h3>Анализ и принятие решений</h3>
            <p>
              Анализ рынка, конкурентов, финансовых данных, обработка больших
              объёмов информации с выводом рекомендаций. Агент может сравнивать
              альтернативы, учитывать ограничения и предлагать оптимальное
              решение с обоснованием.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .content-block {
      max-width: 720px;
      margin: 0 auto;
    }
    .content-block h2 {
      margin-bottom: 16px;
    }
    .content-block > p {
      font-size: 1.02rem;
      line-height: 1.75;
      margin-bottom: 16px;
    }
    .tasks-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 20px;
      margin-top: 24px;
    }
    .task-item {
      padding: 20px;
      background: var(--bg-elevated);
      border-radius: var(--radius);
      border: 1px solid var(--border);
    }
    .task-icon {
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--accent-dim);
      color: var(--accent);
      border-radius: 8px;
      margin-bottom: 12px;
    }
    .task-item h3 {
      font-size: 1rem;
      margin-bottom: 6px;
    }
    .task-item p {
      font-size: 0.88rem;
      line-height: 1.6;
    }
  </style>

  <!-- ТЕХНОЛОГИЯ -->
  <section class="section">
    <div class="container">
      <div class="content-block reveal">
        <h2>Технология</h2>
        <div class="tech-columns">
          <div class="tech-col">
            <h3>Фреймворки</h3>
            <p>
              LangChain — для построения цепочек и агентов с инструментами.
              CrewAI — для мульти-агентных систем с распределением ролей.
              AutoGen — для диалогов между агентами и человека.
              DSPy — для оптимизации промптов и signatures.
            </p>
          </div>
          <div class="tech-col">
            <h3>Архитектура</h3>
            <p>
              Каждый агент включает: модуль планирования (пошаговое разбиение
              задачи), инструментарий (API, поиск, база знаний, calculator),
              память (краткосрочная контекстная и долговременная векторная)
              и систему наблюдаемости (логи, метрики качества, трассировка).
            </p>
          </div>
          <div class="tech-col">
            <h3>RAG-интеграция</h3>
            <p>
              Агенты с RAG получают доступ к вашим документам и базам знаний.
              Гибридный поиск (semantic + keyword), переранжирование,
              сжатие контекста — все техники для точных ответов по вашему
              корпусу документов.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .tech-columns {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
      margin-top: 24px;
    }
    .tech-col {
      padding: 20px;
      background: var(--bg-elevated);
      border-radius: var(--radius);
      border: 1px solid var(--border);
    }
    .tech-col h3 {
      font-size: 0.95rem;
      margin-bottom: 8px;
      color: var(--accent);
    }
    .tech-col p {
      font-size: 0.88rem;
      line-height: 1.65;
    }
  </style>

  <!-- ПРОЦЕСС -->
  <section class="section">
    <div class="container">
      <div class="content-block reveal">
        <h2>Процесс разработки</h2>
        <ol class="process-list">
          <li><strong>Диагностика.</strong> Анализ задачи, данных, ограничений и технической готовности.</li>
          <li><strong>Проектирование архитектуры.</strong> Выбор фреймворка, структуры агента, инструментов и интеграций.</li>
          <li><strong>Прототип (MVP).</strong> Быстрая реализация для проверки гипотезы за 2–4 недели.</li>
          <li><strong>Тестирование и итерации.</strong> Оценка качества ответов, обработка edge-кейсов, настройка промптов.</li>
          <li><strong>Внедрение в production.</strong> Настройка инфраструктуры, мониторинг, логирование, интеграции.</li>
          <li><strong>Поддержка и развитие.</strong> Мониторинг качества, доработки, масштабирование.</li>
        </ol>
      </div>
    </div>
  </section>

  <style>
    .process-list {
      list-style: none;
      counter-reset: step;
      margin-top: 16px;
    }
    .process-list li {
      counter-increment: step;
      padding: 12px 0 12px 48px;
      position: relative;
      border-bottom: 1px solid var(--border);
    }
    .process-list li:last-child {
      border-bottom: none;
    }
    .process-list li::before {
      content: counter(step);
      position: absolute;
      left: 0;
      top: 12px;
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--accent-dim);
      color: var(--accent);
      font-weight: 700;
      font-size: 0.85rem;
      border-radius: 50%;
    }
    .process-list strong {
      color: var(--text);
    }
  </style>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <div class="content-block reveal">
        <h2>Часто задаваемые вопросы</h2>
        <div class="faq-block">
          {faq.map((item) => (
            <div class="faq-item">
              <div class="faq-question">{item.question}</div>
              <div class="faq-answer">{item.answer}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <style>
    .faq-block {
      margin-top: 16px;
    }
    .faq-item {
      border-bottom: 1px solid var(--border);
      padding: 20px 0;
    }
    .faq-item:first-child {
      padding-top: 0;
    }
    .faq-question {
      font-weight: 600;
      font-size: 1rem;
      color: var(--text);
      margin-bottom: 8px;
    }
    .faq-answer {
      font-size: 0.92rem;
      line-height: 1.65;
      color: var(--text-muted);
    }
  </style>

  <!-- CTA -->
  <section class="section cta-block">
    <div class="container">
      <div class="cta-inner reveal">
        <h2>Нужен AI-агент для вашего бизнеса?</h2>
        <p>
          Проведём диагностику, определим архитектуру и покажем прототип
          за 2–4 недели.
        </p>
        <a href="/contact" class="btn">Обсудить разработку AI-агента</a>
      </div>
    </div>
  </section>

  <style>
    .cta-block {
      border-top: none;
      padding-top: 48px;
    }
    .cta-inner {
      max-width: 560px;
      margin: 0 auto;
      text-align: center;
      padding: 32px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 12px;
    }
    .cta-inner h2 {
      margin-bottom: 8px;
    }
    .cta-inner p {
      margin: 0 auto 20px;
      font-size: 1rem;
    }
  </style>
</ServiceLayout>
