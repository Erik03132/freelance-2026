---
// src/pages/faq.astro — FAQ
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Частые вопросы про AI-инжиниринг — AI Bureau';
const description =
  'Ответы на вопросы про AI-агенты, RAG, голосовые боты, private LLM, AI-аудит. Спрашивайте — ответим.';
const canonical = 'https://ai-bureau.pro/faq/';
const ogImage = '/og-default.png';

const questions = [
  {
    q: 'Что такое AI-агенты и зачем они бизнесу?',
    a: 'AI-агенты — автономные системы, способные воспринимать окружение, планировать действия и выполнять сложные бизнес-задачи без постоянного вмешательства человека. В отличие от простых чат-ботов, агенты могут использовать инструменты, работать с документами, вызывать API, принимать решения в многошаговых сценариях. Для бизнеса это автоматизация процессов, снижение операционных затрат и масштабирование без увеличения штата.',
  },
  {
    q: 'Что такое RAG и как это работает?',
    a: 'RAG (Retrieval-Augmented Generation) — технология, при которой языковая модель отвечает на вопросы, опираясь на ваши документы. При обработке запроса система сначала ищет в вашем корпусе документов наиболее релевантные фрагменты, затем передаёт их в модель как контекст. Модель отвечает, опираясь на контекст — так она не выдумывает и работает по вашим данным. Это позволяет создать бота, который «знает» ваш бизнес на уровне документации.',
  },
  {
    q: 'Чем голосовые боты отличаются от обычных чат-ботов?',
    a: 'Голосовые боты работают через речь: они распознают речь клиента (ASR — автоматическое распознавание речи), понимают намерение с помощью LLM, формируют ответ и озвучивают его синтезом речи (TTS — синтез речи). Это позволяет автоматизировать телефонические каналы. Чат-боты работают с текстом — они проще, но не охватывают телефонию.',
  },
  {
    q: 'Что такое private LLM и когда он нужен?',
    a: 'Private LLM — это языковая модель, работающая на вашей инфраструктуре: ваших серверах, вашем GPU, под вашим контролем. Данные не уходят в внешние облака. Private LLM нужен, когда вы работаете с конфиденциальными данными (финансы, медицина, персональные данные, коммерческая тайна), есть требования регуляторов к локации данных, или вы хотите управлять стоимостью инференса в долгосрочной перспективе.',
  },
  {
    q: 'Сколько стоит разработка AI-системы?',
    a: 'Стоимость зависит от сложности задачи, объёма данных, требуемой инфраструктуры и сроков. Прототип (MVP) мы можем подготовить за 2–4 недели — стоимость определяется после диагностики. Полноценная система с интеграциями, тестированием и внедрением — от 4 до 12 недель. Мы работаем по модели: аудит → архитектура → прототип → внедрение, чтобы вы видели стоимость на каждом этапе.',
  },
  {
    q: 'Какой у вас процесс работы?',
    a: 'Наш процесс включает 5 этапов: диагностика (анализ процессов, данных, готовности), архитектура (проектирование системы, выбор технологий), прототип (быстрый MVP за 2–4 недели для проверки гипотезы), внедрение (полноценная система в production) и поддержка (мониторинг, доработки, масштабирование). Каждый этап с согласованием, документацией и метриками.',
  },
  {
    q: 'Какие технологии вы используете?',
    a: 'Мы работаем с LangChain, CrewAI, AutoGen, DSPy, LlamaIndex для AI-агентов и RAG, с Milvus, Qdrant, Weaviate, Chroma для векторных баз данных, с Llama, Mistral и другими открытыми моделями для private LLM, с Whisper и облачными ASR/TTS для голосовых ботов. Стек подбирается под вашу задачу — мы не привязаны к одному вендору.',
  },
  {
    q: 'Как быстро можно получить прототип?',
    a: 'Прототип (MVP) мы можем подготовить за 2–4 недели для проверки гипотезы. Сначала проводим диагностику и проектирование архитектуры — это 1–2 недели, затем реализация прототипа — 1–3 недели в зависимости от сложности. Прототип позволяет вам увидеть рабочий продукт, оценить качество ответов и принять решение о полноценном внедрении.',
  },
  {
    q: 'Что такое LLMOps и зачем он бизнесу?',
    a: 'LLMOps — это операции с языковыми моделями в production: мониторинг качества, управление версиями моделей и промптов, логирование запросов, трассировка, оценка drift, оптимизация инференса. LLMOps нужен бизнесу для того, чтобы AI-система работала стабильно, предсказуемо и измеримо после внедрения — не просто в эксперименте, а в реальном бизнес-процессе с контролем качества и затрат.',
  },
  {
    q: 'Как защитить данные при использовании AI?',
    a: 'Защита данных зависит от архитектуры решения. При использовании private LLM данные не покидают вашу инфраструктуру — вы управляете доступом, логированием, изоляцией. При использовании облачных моделей мы настраивваем передачу только необходимых данных, используем минимальные контексты, не передаём конфиденциальную информацию. При проектировании каждый сценарий проходит оценку безопасности: какие данные где обрабатываются, кто имеет доступ, как логируется.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<BaseLayout {title} {description} {canonical} {ogImage}>
  <section class="hero">
    <div class="container">
      <div class="hero-content reveal">
        <span class="label">FAQ</span>
        <h1>Частые вопросы про AI-инжиниринг</h1>
        <p class="hero-desc">
          Ответы на вопросы про AI-агенты, RAG, голосовые боты, private LLM,
          AI-аудит, LLMOps, промпт-инжиниринг и процесс работы.
        </p>
      </div>
    </div>
  </section>

  <style>
    .hero {
      padding: 60px 0 48px;
      background: radial-gradient(ellipse at 20% 50%, var(--accent-dim) 0%, transparent 60%);
    }
    .hero-content {
      max-width: 620px;
    }
    .hero-desc {
      font-size: 1.05rem;
      color: var(--text);
      margin: 12px 0 0;
      line-height: 1.6;
    }
  </style>

  <!-- JSON-LD FAQPage (глобально для страницы) -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqJsonLd)}
  />

  <section class="section">
    <div class="container">
      <div class="faq-list">
        {questions.map((item, i) => (
          <div class="faq-item" id={`faq-${i + 1}`}>
            <div class="faq-question">
              <span>{item.q}</span>
              <svg class="faq-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </div>
            <div class="faq-answer">{item.a}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    .faq-list {
      max-width: 720px;
      margin: 0 auto;
    }
    .faq-item {
      border-bottom: 1px solid var(--border);
      padding: 24px 0;
    }
    .faq-item:first-child {
      padding-top: 0;
    }
    .faq-question {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      cursor: pointer;
      font-weight: 600;
      font-size: 1.05rem;
      color: var(--text);
    }
    .faq-icon {
      flex-shrink: 0;
      transition: transform 0.2s;
    }
    .faq-item.open .faq-icon {
      transform: rotate(180deg);
    }
    .faq-answer {
      margin-top: 12px;
      font-size: 0.95rem;
      line-height: 1.7;
      color: var(--text-muted);
    }

    /* Интерактивность — раскрытие */
    @media (hover: hover) {
      .faq-question:hover .faq-icon {
        color: var(--accent);
      }
    }

    /* Для раскрытия через CSS (без JS) используем checkbox-hack */
    .faq-toggle {
      display: none;
    }
    .faq-toggle:checked + .faq-answer-label .faq-answer {
      display: block;
    }
    .faq-answer-label .faq-answer {
      display: none;
    }
  </style>

  <section class="section cta-block">
    <div class="container">
      <div class="cta-inner reveal">
        <h2>Есть ещё вопросы?</h2>
        <p>
          Спрашивайте напрямую — проведём диагностику и ответим
          на все вопросы по вашей задаче.
        </p>
        <a href="/contact" class="btn">Задать вопрос</a>
      </div>
    </div>
  </section>

  <style>
    .cta-block {
      border-top: none;
      padding-top: 48px;
    }
    .cta-inner {
      max-width: 560px;
      margin: 0 auto;
      text-align: center;
      padding: 32px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 12px;
    }
    .cta-inner h2 { margin-bottom: 8px; }
    .cta-inner p { margin: 0 auto 20px; font-size: 1rem; }
  </style>
</BaseLayout>
