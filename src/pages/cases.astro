---
// src/pages/cases.astro — Кейсы
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Кейсы AI Bureau — автономные AI-системы в действии';
const description =
  'Кейсы AI Bureau: AI-агенты, RAG-чатботы, голосовые боты, private LLM. Проблема → решение → результат.';
const canonical = 'https://ai-bureau.pro/cases/';
const ogImage = '/og-default.png';

// Статьи блога — пока заглушка, но структура для Articles есть
const cases = [
  {
    id: 1,
    title: 'AI-колл-центр для retail-сети',
    service: 'Голосовые боты',
    tags: ['Голосовые боты', 'ASR/TTS', 'AI-колл-центр'],
    problem: 'Retail-сеть с 50+ точками получала тысячи входящих звонков ежедневно. Операторы тратили до 60% времени на рутинные запросы: проверка наличия товара, цены, запись на гарантийный ремонт. Очереди в часы пик — до 15 минут ожидания.',
    solution: 'Разработали голосового AI-агента, который принимает входящие звонки, распознаёт речь, отвечает на вопросы по наличию и ценам, записывает на ремонт и передаёт сложные случаи операторам с предисторией. Интеграция с CRM и системой складского учёта.',
    result: 'Агент обрабатывает 40% входящих звонков без операторов. Среднее время ожидания сократилось с 12 до 2 минут. Удовлетворённость клиентов выросла на 18% по опросу.',
  },
  {
    id: 2,
    title: 'RAG-чатбот для технической документации',
    service: 'RAG-чатботы',
    tags: ['RAG', 'Корпоративный поиск', 'Векторная БД'],
    problem: 'Крупная IT-компания хранила тысячи страниц технической документации, инструкций и внутренних стандартов. Сотрудники тратили в среднем 15 минут на поиск ответа по конкретному вопросу, часто не находили нужный документ или уходили с устаревшей информацией.',
    solution: 'Создали RAG-чатбота на базе знаний компании: загрузили все документы, настроили векторную базу Qdrant, гибридный поиск (semantic + keyword) и переранжирование результатов. Бот отвечает на вопросы по документации с указанием источника.',
    result: 'Время поиска ответа сократилось с 15 минут до 30 секунд. Сотрудники используют бота как первый канал поиска вместо ручного поиска по архивам. Точность ответов — 92% по оценке экспертов.',
  },
  {
    id: 3,
    title: 'Private LLM для анализа финансовых отчётов',
    service: 'Private LLM',
    tags: ['Private LLM', 'On-premise', 'Анализ данных'],
    problem: 'Финансовая компания анализировала ежемесячные отчёты, сверяла данные по контрактам и выявляла аномалии — вручную, с командой аналитиков. Данные содержали конфиденциальную информацию, и передача их во внешние API была запрещена регулятором.',
    solution: 'Развёрнули private LLM на собственных GPU-серверах: модель Llama 3 70B, инференс через vLLM, изолированная сеть, контроль доступа. Модель анализирует отчёты, сравнивает цифры по контрактам, отмечает аномалии и формирует preliminary-выводы для analysts.',
    result: 'Обработка ежемесячного отчёта сократилась с 3 дней до 4 часов. Данные не покидают инфраструктуру — соответствие регуляторным требованиям. Стоимость инференса в 3 раза ниже, чем облачный API.',
  },
];
---

<BaseLayout {title} {description} {canonical} {ogImage}>
  <section class="hero">
    <div class="container">
      <div class="hero-content reveal">
        <span class="label">Кейсы</span>
        <h1>Кейсы: как мы внедряем AI в бизнес</h1>
        <p class="hero-desc">
          Проблема → решение → результат. Каждый кейс — реальная задача,
          наша архитектура, измеримый результат.
        </p>
      </div>
    </div>
  </section>

  <style>
    .hero {
      padding: 60px 0 48px;
      background: radial-gradient(ellipse at 20% 50%, var(--accent-dim) 0%, transparent 60%);
    }
    .hero-content {
      max-width: 620px;
    }
    .hero-desc {
      font-size: 1.05rem;
      color: var(--text);
      margin: 12px 0 0;
      line-height: 1.6;
    }
  </style>

  <section class="section">
    <div class="container">
      <div class="cases-grid">
        {cases.map((c) => (
          <article class="case-card reveal">
            <div class="case-header">
              <div class="case-tags">
                {c.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </div>
            <h2>{c.title}</h2>
            <div class="case-body">
              <div class="case-block">
                <div class="case-block-label">Проблема</div>
                <p>{c.problem}</p>
              </div>
              <div class="case-block">
                <div class="case-block-label">Решение</div>
                <p>{c.solution}</p>
              </div>
              <div class="case-block">
                <div class="case-block-label">Результат</div>
                <p>{c.result}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <style>
    .cases-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 24px;
    }
    .case-card {
      padding: 28px;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }
    .case-header {
      margin-bottom: 16px;
    }
    .case-tags {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .tag {
      display: inline-block;
      padding: 2px 8px;
      background: var(--accent-dim);
      color: var(--accent);
      font-size: 0.75rem;
      font-weight: 600;
      border-radius: 4px;
    }
    .case-card h2 {
      font-size: 1.25rem;
      margin-bottom: 20px;
    }
    .case-body {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .case-block {
      border-left: 2px solid var(--accent);
      padding-left: 16px;
    }
    .case-block-label {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent);
      margin-bottom: 4px;
    }
    .case-block p {
      font-size: 0.9rem;
      line-height: 1.65;
    }
  </style>

  <!-- JSON-LD Articles для кейсов -->
  {cases.map((c) => (
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: c.title,
        description: `${c.problem} ${c.solution} ${c.result}`,
        datePublished: '2026-01-15',
        author: {
          '@type': 'Organization',
          name: 'AI Bureau',
          url: 'https://ai-bureau.pro',
        },
        publisher: {
          '@type': 'Organization',
          name: 'AI Bureau',
          url: 'https://ai-bureau.pro',
        },
      })}
    />
  ))}

  <section class="section cta-block">
    <div class="container">
      <div class="cta-inner reveal">
        <h2>Хотите такой же результат?</h2>
        <p>
          Проведём диагностику, спроектируем архитектуру и покажем
          прототип за 2–4 недели.
        </p>
        <a href="/contact" class="btn">Запросить консультацию</a>
      </div>
    </div>
  </section>

  <style>
    .cta-block {
      border-top: none;
      padding-top: 48px;
    }
    .cta-inner {
      max-width: 560px;
      margin: 0 auto;
      text-align: center;
      padding: 32px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 12px;
    }
    .cta-inner h2 { margin-bottom: 8px; }
    .cta-inner p { margin: 0 auto 20px; font-size: 1rem; }
  </style>
</BaseLayout>
